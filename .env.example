# Tryitout environment variables — names only (implementation.md §13).
# Copy to .env.local for the web app and set the values from your own projects.
# Never commit a filled-in file. Secrets never reach the client bundle.

# ── Web (apps/web, Vite: only VITE_* reach the browser) ───────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WORKER_URL=
VITE_VAPID_PUBLIC_KEY=
VITE_SENTRY_DSN=
# local | staging | production
VITE_APP_ENV=local

# ── Supabase Edge Functions (set with `supabase secrets set`) ─────────────────
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
R2_ACCOUNT_ID=
R2_READ_KEY_ID=
R2_READ_SECRET=
R2_BUCKET=
SENTRY_DSN=

# ── Modal secret `tryitout` (one per Modal environment) ───────────────────────
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_JWKS_URL
# R2_ACCOUNT_ID
# R2_WRITE_KEY_ID
# R2_WRITE_SECRET
# R2_BUCKET
# SENTRY_DSN

# ── Free-tier usage caps (§13) ────────────────────────────────────────────────
CAP_SCANS_PER_DAY=2
CAP_GARMENT_ANALYSES_PER_DAY=10
CAP_BUILDS_PER_DAY=5
